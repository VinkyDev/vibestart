{
  "$schema": "https://vibestart.net/schema.json",

  "stack": {
    "mode": "standard",
    "toolchain": "vite-plus",
    "frontend": "react",
    "framework": "spa",
    "router": "tanstack-router",
    "backend": "hono",
    "api": "openapi",
    "database": "mysql",
    "orm": "drizzle",
    "auth": "better-auth",
    "ui": "shadcn",
    "runtime": "workers",
    "deployment": "void",
    "testing": "e2e",
  },

  "addons": ["knip", "ultracite"],

  "channel": "recommended",
}
