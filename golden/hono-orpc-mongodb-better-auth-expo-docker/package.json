{
  "name": "my-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "ready": "vp check && vp run knip && vp test && vp run -r build",
    "prepare": "vp config",
    "db:migrate": "vp run --filter @my-app/server db:migrate",
    "dev:mobile": "vp run --filter @my-app/mobile start",
    "knip": "knip"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.15.0"
  }
}
