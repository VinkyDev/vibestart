{
  "$schema": "https://vibestart.net/schema.json",

  "stack": {
    "mode": "standard",
    "toolchain": "vite-plus",
    "backend": "hono",
    "api": "orpc",
    "database": "mongodb",
    "orm": "mongoose",
    "auth": "better-auth",
    "mobile": "expo",
    "runtime": "node",
    "deployment": "docker",
    "testing": "playwright",
  },

  "addons": ["knip", "ultracite"],

  "channel": "recommended",
}
