{
  "name": "my-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "ready": "vp check && vp run knip && vp test && vp run test:e2e && vp run -r build",
    "prepare": "vp config",
    "deploy": "node scripts/deploy.ts",
    "test:e2e": "vp run --filter @my-app/web test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
