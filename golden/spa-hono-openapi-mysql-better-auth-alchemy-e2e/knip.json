{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/typegen.ts", "alchemy.run.ts"],
      "ignoreDependencies": ["@effect/platform-node", "@effect/platform-bun"]
    },
    "apps/server": {
      "entry": ["src/worker.ts"],
      "ignoreDependencies": ["@my-app/web"]
    },
    "apps/web": {
      "entry": [
        "e2e.config.ts",
        "tests/e2e/**/*.e2e.ts",
        "tests/support/start.ts"
      ]
    }
  }
}
