{
  "name": "vibestart-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deps": "node packages/integrations/scripts/deps.ts",
    "knip": "knip",
    "stacks": "node packages/integrations/scripts/stacks.ts",
    "ready": "vp check && vp run knip && vp test",
    "prepare": "vp config",
    "cli": "vp run --filter vibestart-cli build && node apps/cli/dist/cli.mjs"
  },
  "devDependencies": {
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "@vibestart/config": "workspace:*",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.8.1"
  }
}
