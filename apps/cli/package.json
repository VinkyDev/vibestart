  },
  "dependencies": {
    "oxfmt": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@types/node": "catalog:",
    "@vibestart/config": "workspace:*",
    "@vibestart/core": "workspace:*",
    "@vibestart/integrations": "workspace:*",
    "citty": "catalog:",
    "execa": "catalog:",
    "jsonc-parser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
