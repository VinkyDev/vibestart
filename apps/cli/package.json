{
  "name": "vibestart-cli",
  "version": "0.1.0-beta.4",
  "description": "Create a verified full-stack TypeScript project from a stack you compose",
  "keywords": [
    "create",
    "scaffold",
    "stack",
    "vite-plus"
  ],
  "homepage": "https://github.com/VinkyDev/vibestart#readme",
  "bugs": {
    "url": "https://github.com/VinkyDev/vibestart/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinkyDev/vibestart.git",
    "directory": "apps/cli"
  },
  "bin": {
    "vibestart": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
