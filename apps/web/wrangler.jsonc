{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibestart",
  "compatibility_date": "2026-10-04",
  // Routes, not custom domains: each host's DNS record is an unproxied CNAME to a preferred
  // Cloudflare hostname, which a custom domain would replace with a proxied one.
  "routes": [
    { "pattern": "vibestart.net/*", "zone_name": "vibestart.net" },
    { "pattern": "www.vibestart.net/*", "zone_name": "vibestart.net" },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
